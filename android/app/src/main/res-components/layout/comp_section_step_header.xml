<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ivStepIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_badge"
        app:tint="@color/huc_primary_container" />

    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Huc.TitleMd"
        tools:text="Datos de Filiación" />

    <TextView
        android:id="@+id/tvStepBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/huc_on_surface_variant"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Paso 1 de 3" />

</LinearLayout>
