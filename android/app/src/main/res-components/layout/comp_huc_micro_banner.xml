<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/microBannerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_primary_container_16"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/huc_space_md">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_primary">

        <ImageView
            android:id="@+id/ivBannerIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_domain"
            app:tint="@color/huc_primary_fixed" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/huc_space_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/huc_primary_fixed"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Hospital Universitario Central - Admisión" />

        <TextView
            android:id="@+id/tvBannerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/huc_on_primary_container"
            android:textSize="12sp"
            tools:text="Puesto de Admisión Activo • Turno Matutino" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bannerStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp"
        android:paddingVertical="4dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot_circle"
            android:backgroundTint="@color/huc_primary_fixed" />

        <TextView
            android:id="@+id/tvBannerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/huc_online"
            android:textColor="@color/huc_primary_fixed"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
