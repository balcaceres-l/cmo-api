<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topBarRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/huc_topbar_height"
    android:background="@color/huc_primary_container"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/huc_space_md">

    <!-- Marca Institucional HUC + CMO -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_primary">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_local_hospital"
            app:tint="@color/huc_primary_fixed" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/huc_space_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBrandHuc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/huc_brand_title"
                android:textColor="@color/huc_on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBrandCmo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_primary"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="@string/huc_brand_badge"
                android:textColor="@color/huc_primary_fixed"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvModuleSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/huc_on_primary_container"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="PACIENTES" />
    </LinearLayout>

    <!-- Pill Guardia Activa -->
    <LinearLayout
        android:id="@+id/btnGuardiaPill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_pill_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_circle"
            android:backgroundTint="@color/huc_primary_fixed" />

        <TextView
            android:id="@+id/tvGuardiaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/huc_guardia_activa"
            android:textColor="@color/huc_primary_fixed"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/huc_on_primary" />
    </LinearLayout>

    <!-- Acción Secundaria Opcional (ej. Agendar Cita de Seguimiento en Doctor) -->
    <FrameLayout
        android:id="@+id/btnSecondaryAction"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_circle_primary"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivSecondaryAction"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_event"
            app:tint="@color/huc_primary_fixed" />
    </FrameLayout>

    <!-- Botón Perfil / Cierre de Sesión -->
    <FrameLayout
        android:id="@+id/btnProfileAction"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_circle_primary"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_person"
            app:tint="@color/huc_on_primary" />
    </FrameLayout>

</LinearLayout>
