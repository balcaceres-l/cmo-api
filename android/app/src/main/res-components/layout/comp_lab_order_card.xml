<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/labOrderCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_low_16"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Fila Superior: Prioridad + Tubo + Selector de Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLabPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_error_container"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/huc_on_error_container"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="⚡ STAT" />

        <TextView
            android:id="@+id/tvLabTubeBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/huc_on_surface_variant"
            android:textSize="11sp"
            tools:text="Protocolo SCA • Hoy, 10:32" />

        <LinearLayout
            android:id="@+id/btnLabStatusSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_primary_container"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvLabStatusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/huc_on_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="En Espera" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/huc_on_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nombre del Examen -->
    <TextView
        android:id="@+id/tvLabExamName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Huc.TitleSm"
        tools:text="Troponina I Alta Sensibilidad (hs-cTnI)" />

    <!-- Paciente / Expediente -->
    <TextView
        android:id="@+id/tvLabPatientInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/huc_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Carlos Mendoza • Exp: CM-2026-001" />

    <!-- Observaciones / Resultado -->
    <TextView
        android:id="@+id/tvLabNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/huc_on_surface_variant"
        android:textSize="12sp"
        tools:text="Cinética enzimática 0h - 1h por dolor torácico opresivo." />

    <TextView
        android:id="@+id/tvLabResultDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/huc_semaforo_verde"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="✓ Resultado validado: Hoy, 09:42"
        tools:visibility="visible" />

</LinearLayout>
