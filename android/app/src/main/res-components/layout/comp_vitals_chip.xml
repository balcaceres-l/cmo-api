<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vitalsChipRoot"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_surface_low_16"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvVitalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/huc_on_surface_variant"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="PA" />

    <TextView
        android:id="@+id/tvVitalValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/manrope_bold"
        android:textColor="@color/huc_on_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="120/80 mmHg" />

    <TextView
        android:id="@+id/tvVitalSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/huc_primary_container"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="Normal"
        tools:visibility="visible" />

</LinearLayout>
