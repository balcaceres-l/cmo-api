<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cmo_radial_dark">

    <!-- Anillos decorativos idénticos a Web LoginPage -->
    <View
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_cmo_ring_subtle" />

    <View
        android:layout_width="640dp"
        android:layout_height="640dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_cmo_ring_subtle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="32dp">

            <!-- Tarjeta Principal estilo Web LoginPage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card_24"
                android:elevation="12dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="30dp"
                android:paddingBottom="24dp">

                <!-- Cabecera de Marca Oficial CMO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/bg_logo_card_24"
                        android:elevation="4dp"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo_cmo_icon" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:letterSpacing="-0.02"
                        android:text="@string/cmo_brand_title"
                        android:textColor="@color/cmo_primary_dark"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:text="Centro Médico de Occidente — Terminal Clínico"
                        android:textColor="@color/cmo_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Banner Condicional de Error -->
                <LinearLayout
                    android:id="@+id/bannerLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_error_container_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/triage_critico" />

                    <TextView
                        android:id="@+id/tvLoginError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:textColor="@color/triage_critico_text"
                        android:textSize="12sp"
                        tools:text="Credenciales incorrectas." />
                </LinearLayout>

                <!-- Campo Usuario -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Usuario Institucional"
                    android:textColor="@color/cmo_text"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsuario"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/cmo_text_soft">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:hint="Ej. medico.general o recepcion"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/cmo_text"
                        android:textColorHint="@color/cmo_text_soft"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Contraseña -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Contraseña"
                    android:textColor="@color/cmo_text"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/cmo_text_soft"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/cmo_text_soft">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:hint="Ingresa tu contraseña"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/cmo_text"
                        android:textColorHint="@color/cmo_text_soft"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón Iniciar Sesión + Indicador de Carga -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoginSubmit"
                        style="@style/Widget.Huc.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Iniciar Sesión" />

                    <ProgressBar
                        android:id="@+id/progressLogin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/cmo_white"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Separador + Accesos Rápidos de Demostración por Cargo -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/cmo_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="ACCESO RÁPIDO POR CARGO"
                    android:textColor="@color/cmo_text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoMedicoGeneral"
                        style="@style/Widget.Huc.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/role_medico_bg"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🩺 Dra. Gral"
                        android:textColor="@color/role_medico_text"
                        android:textSize="12sp"
                        app:strokeColor="@color/role_medico_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoMedicoUrgencias"
                        style="@style/Widget.Huc.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/triage_critico_bg"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🚨 Dr. Urgencias"
                        android:textColor="@color/triage_critico_text"
                        android:textSize="12sp"
                        app:strokeColor="@color/triage_critico_border" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoRecepcion"
                        style="@style/Widget.Huc.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/role_recep_bg"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🏥 Recepción"
                        android:textColor="@color/role_recep_text"
                        android:textSize="12sp"
                        app:strokeColor="@color/role_recep_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoEnfermeria"
                        style="@style/Widget.Huc.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/cmo_primary_soft"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="💉 Enfermería"
                        android:textColor="@color/cmo_primary"
                        android:textSize="12sp"
                        app:strokeColor="@color/cmo_border_strong" />
                </LinearLayout>

                <!-- Sello de Seguridad Sanctum -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/cmo_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Acceso seguro protegido por Laravel Sanctum"
                        android:textColor="@color/cmo_text_soft"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
