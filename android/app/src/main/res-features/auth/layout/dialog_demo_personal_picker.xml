<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cmo_surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/cmo_border_strong" />

    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="Seleccionar perfil (Demo)"
        android:textColor="@color/cmo_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvPickerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Elige una cuenta En turno o Fuera de turno para probar"
        android:textColor="@color/cmo_text_muted"
        android:textSize="12sp" />

    <!-- Filtro de estado de turno -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstadoTodos"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Todos"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstadoEnTurno"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="En turno"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstadoFuera"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fuera de turno"
            android:textSize="12sp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Filtro dinámico por especialidad / subgrupo -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSubgrupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressPicker"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPickerEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:text="No hay personal en este filtro."
        android:textColor="@color/cmo_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDemoPersonal"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

</LinearLayout>
