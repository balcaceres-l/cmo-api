<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/huc_surface_lowest"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_primary_container_16">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_qr_code"
                app:tint="@color/huc_primary_fixed" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brazalete Clínico QR Emitido"
                android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

            <TextView
                android:id="@+id/tvQrUuid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/huc_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="UUID: 8F24A910-B32C" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_surface_low_16"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvQrPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/huc_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Francisca Elena Navarro Silva" />

        <TextView
            android:id="@+id/tvQrDatosFiliacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/huc_on_surface_variant"
            android:textSize="12sp"
            tools:text="DNI: 17.489.201-3 • Exp: FN-2026-041" />

        <TextView
            android:id="@+id/tvQrCamaYTriage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/huc_primary_container"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Ubicación: VIP-302 • Nivel III: Amarillo" />

        <TextView
            android:id="@+id/tvQrFirma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/huc_outline"
            android:textSize="11sp"
            tools:text="Firma Criptográfica: SHA256-HUC-90A12C" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarQrDialog"
        style="@style/Widget.Huc.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:text="Listo • Cerrar Vista Previa" />

</LinearLayout>
