<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huc_surface"
    android:orientation="vertical">

    <!-- ─────────────────────────────────────────────────────────────────────────
         TabLayout Superior Material 3 (2 Tabs)
         ───────────────────────────────────────────────────────────────────────── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutAdmision"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/huc_surface_lowest"
        android:elevation="2dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/huc_primary_container"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/huc_primary_container"
        app:tabTextAppearance="@style/TextAppearance.Huc.TitleSm"
        app:tabTextColor="@color/huc_on_surface_variant">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_how_to_reg"
            android:text="Ingreso a cama" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_meeting_room"
            android:text="Vista de Habitaciones" />
    </com.google.android.material.tabs.TabLayout>

    <!-- ─────────────────────────────────────────────────────────────────────────
         TAB 1: Ingreso de un paciente registrado (POST /ingresos)
         ───────────────────────────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTabRegistro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="88dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Micro-banner institucional -->
            <include
                android:id="@+id/microBannerAdmision"
                layout="@layout/comp_huc_micro_banner" />


            <!-- Paso 1: paciente registrado, médico tratante y motivo (POST /ingresos) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <include
                    android:id="@+id/stepHeader1"
                    layout="@layout/comp_section_step_header" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAdmPacienteBuscar"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Buscar paciente por nombre, DUI o expediente *"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAdmPacienteBuscar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAdmPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:singleSelection="true" />

                <TextView
                    android:id="@+id/tvAdmPacienteSeleccionado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_surface_low_16"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Ningún paciente seleccionado"
                    android:textColor="@color/huc_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Médico tratante *"
                    android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                    android:textColor="@color/huc_on_surface_variant" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAdmMedicos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAdmMotivo"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Motivo del ingreso *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAdmisionMotivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Paso 2: mapa de camas desde GET /habitaciones -->
            <LinearLayout
                android:id="@+id/cardPaso3Camas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <include
                    android:id="@+id/stepHeader2"
                    layout="@layout/comp_section_step_header" />

                <TextView
                    android:id="@+id/tvAdmCamasAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Toque una cama libre para el ingreso, o una ocupada para dar el alta o trasladar."
                    android:textAppearance="@style/TextAppearance.Huc.BodySm" />

                <!-- Barra de Estado de Ocupación e Indicador Estricto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_surface_container_16"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_rule"
                            app:tint="@color/huc_primary_container" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Capacidad Hospitalaria"
                            android:textAppearance="@style/TextAppearance.Huc.TitleSm" />

                        <TextView
                            android:id="@+id/tvCapacidadOcupadasPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_primary_container"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="14 / 17 Ocupadas"
                            android:textColor="@color/huc_primary_fixed"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressHospitalCapacity"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="82"
                        android:progressDrawable="@drawable/bg_progress_hospital_capacity" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_circle"
                            android:backgroundTint="@color/huc_primary_fixed_dim" />

                        <TextView
                            android:id="@+id/tvCapacidadDisponibles"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="3 Camas Disponibles"
                            android:textColor="@color/huc_on_surface"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/huc_error" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Sobrecupo Bloqueado"
                            android:textColor="@color/huc_error"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Planta 3: VIP Individuales (VIP-301 a VIP-305) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        app:tint="@color/huc_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="3ª Planta • VIP Individual"
                        android:textAppearance="@style/TextAppearance.Huc.TitleSm" />

                    <TextView
                        android:id="@+id/tvVipCountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Disp. / 5 Totales"
                        android:textColor="@color/huc_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCamasVip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_cama_vip" />

                <!-- Planta 2: Semiprivadas (HAB-201 a HAB-206 A/B) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_meeting_room"
                        app:tint="@color/huc_primary_container" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="2ª Planta • Semiprivadas (A / B)"
                        android:textAppearance="@style/TextAppearance.Huc.TitleSm" />

                    <TextView
                        android:id="@+id/tvSemiCountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Disp. / 12 Totales"
                        android:textColor="@color/huc_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSalasSemiprivadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_sala_semiprivada" />

                <!-- Cama Asignada Actual Feedback -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_surface_container_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_single_bed"
                        app:tint="@color/huc_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Cama elegida:"
                        android:textAppearance="@style/TextAppearance.Huc.LabelMd" />

                    <TextView
                        android:id="@+id/tvSelectedBedPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded_16"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Ninguna seleccionada"
                        android:textColor="@color/huc_primary_container"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdmFormError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_error_container_16"
                android:padding="10dp"
                android:textColor="@color/huc_on_error_container"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="La cama seleccionada está ocupada." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarIngreso"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Ingresar paciente"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ─────────────────────────────────────────────────────────────────────────
         TAB 2: Vista de Habitaciones (Panel Detallado con Pacientes Internados)
         ───────────────────────────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutTabHabitaciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="88dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner Institucional de Habitaciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_domain"
                        app:tint="@color/huc_primary_container" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:letterSpacing="0.06"
                        android:text="HOSPITALIZACIÓN CMO"
                        android:textColor="@color/huc_primary_container"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vista de Habitaciones &amp; Pacientes"
                    android:textAppearance="@style/TextAppearance.Huc.HeadlineSm" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Consulte la ocupación por habitación y el detalle clínico de pacientes internados."
                    android:textAppearance="@style/TextAppearance.Huc.BodySm" />

                <!-- Métricas Rápidas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_surface_container_16"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="11 Habitaciones (17 Camas)"
                            android:textAppearance="@style/TextAppearance.Huc.TitleSm" />

                        <TextView
                            android:id="@+id/tvHabCapacidadOcupadasPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_primary_container"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="14 Ocupadas"
                            android:textColor="@color/huc_primary_fixed"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressHospitalCapacityTab2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="82"
                        android:progressDrawable="@drawable/bg_progress_hospital_capacity" />

                    <TextView
                        android:id="@+id/tvHabCapacidadDisponibles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3 Camas Disponibles para Asignación Inmediata"
                        android:textColor="@color/huc_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Filtros de Habitaciones: Tipo y Disponibilidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/huc_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="FILTRAR HABITACIONES"
                        android:textColor="@color/huc_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFiltrosActivosBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_secondary_fixed"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="11 Habitaciones"
                        android:textColor="@color/huc_on_secondary_fixed"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnResetFiltrosHabitaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:text="Restablecer"
                        android:textColor="@color/huc_error"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Campo de Búsqueda Rápida -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuscarHabitacion"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Buscar por código, paciente o motivo..."
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBuscarHabitacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 1. Filtro por Tipo de Habitación -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="1. Tipo de Habitación"
                    android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                    android:textColor="@color/huc_on_surface_variant" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFiltroHabTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltroHabTodas"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Todas (11)"
                            android:textSize="12sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltroHabVip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIP Individual (5)"
                            android:textSize="12sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltroHabSemi"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semiprivadas (6)"
                            android:textSize="12sp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/huc_outline_variant" />

                <!-- 2. Filtro por Disponibilidad de Camas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Disponibilidad de Camas"
                    android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                    android:textColor="@color/huc_on_surface_variant" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFiltroHabOcup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltroOcupTodas"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Cualquier Estado"
                            android:textSize="12sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltroOcupDisp"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Con Disponibilidad"
                            android:textSize="12sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltroOcupLlenas"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100% Ocupadas"
                            android:textSize="12sp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Lista de Habitaciones Detalladas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHabitacionesDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_habitacion_detalle" />

            <TextView
                android:id="@+id/tvHabitacionesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_surface_low_16"
                android:gravity="center"
                android:padding="24dp"
                android:text="No se encontraron habitaciones con los filtros seleccionados."
                android:textColor="@color/huc_on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
