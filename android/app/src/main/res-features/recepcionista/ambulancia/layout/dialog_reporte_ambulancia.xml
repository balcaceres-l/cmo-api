<?xml version="1.0" encoding="utf-8"?>
<!-- POST /ambulancia/servicios/{id}/reportes: aviso a emergencia antes de la llegada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reporte desde la ambulancia"
        android:textAppearance="@style/TextAppearance.Huc.TitleLg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Estado del paciente *"
        android:textAppearance="@style/TextAppearance.Huc.LabelMd"
        android:textColor="@color/huc_on_surface_variant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupEstadoPaciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReporteMinutos"
        style="@style/Widget.Huc.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Minutos para llegar (opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReporteMinutos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Huc.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Observaciones (signos, tratamiento en ruta…)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReporteObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvReporteError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_error_container_16"
        android:padding="10dp"
        android:textColor="@color/huc_on_error_container"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Solo se pueden enviar reportes de un servicio en curso." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReporteCancelar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReporteEnviar"
            style="@style/Widget.Huc.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Enviar a emergencia" />
    </LinearLayout>
</LinearLayout>
