<?xml version="1.0" encoding="utf-8"?>
<!-- POST /ambulancia/servicios: dirección, paciente, descripción y prioridad son obligatorios. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/huc_surface_lowest"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Despachar ambulancia"
            android:textAppearance="@style/TextAppearance.Huc.TitleLg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="La unidad pasa a En servicio hasta que se finalice el traslado."
            android:textAppearance="@style/TextAppearance.Huc.BodySm" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDespachoDireccion"
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Dirección exacta *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDespachoDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDespachoPaciente"
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Nombre o referencia del paciente *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDespachoPaciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDespachoDescripcion"
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Descripción de la emergencia *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDespachoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Prioridad *"
            android:textAppearance="@style/TextAppearance.Huc.LabelMd"
            android:textColor="@color/huc_on_surface_variant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/tvDespachoError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_error_container_16"
            android:padding="10dp"
            android:textColor="@color/huc_on_error_container"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="La ambulancia no está disponible." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDespachoCancelar"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:text="Cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDespachoConfirmar"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Despachar"
                app:backgroundTint="@color/huc_error" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
