<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huc_surface"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tarjeta Unidad Única Institucional: Ambulancia Alfa-1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded_16"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_primary_container">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ambulance"
                        app:tint="@color/huc_primary_fixed" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ambulancia del hospital"
                        android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                    <TextView
                        android:id="@+id/tvAmbulanciaPlaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Placa: —"
                        android:textAppearance="@style/TextAppearance.Huc.BodySm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAmbulanciaEstadoPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_tertiary_fixed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="EN_SERVICIO"
                    android:textColor="@color/huc_on_tertiary_fixed"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3 Chips Interactivos de Estado Operativo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Estado (cambia al despachar y finalizar)"
                android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                android:textColor="@color/huc_on_surface_variant" />

            <TextView
                android:id="@+id/tvAmbTiempoReal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/huc_on_surface_variant"
                android:textSize="11sp"
                tools:text="● En vivo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAmbDisponible"
                    style="@style/Widget.Huc.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="Disponible"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAmbEnServicio"
                    style="@style/Widget.Huc.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="En Servicio"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAmbMantenimiento"
                    style="@style/Widget.Huc.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.15"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="Mantenimiento"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tarjeta Condicional: Misión en Curso -->
            <LinearLayout
                android:id="@+id/cardMisionActiva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_error_container_16"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/tvMisionTitulo"
                        android:text="🚨 SERVICIO EN CURSO"
                        android:textColor="@color/huc_on_error_container"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMisionEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded_16"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/huc_error"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Salió 10:42" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMisionPacienteYDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/huc_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Adulto mayor politraumatizado • Traslado UCI Coronario urgente" />

                <TextView
                    android:id="@+id/tvMisionDireccionYDestino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/huc_on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Origen: Av. Libertador #412 → Hosp. Universitario - Ala B" />

                <TextView
                    android:id="@+id/tvMisionUltimoReporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/huc_primary_container"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Último reporte 10:55 • DELICADO • llega 11:10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMisionReportar"
                        style="@style/Widget.Huc.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Enviar reporte"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMisionFinalizar"
                        style="@style/Widget.Huc.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Finalizar servicio"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirModalDespacho"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Despachar ambulancia"
                app:backgroundTint="@color/huc_error"
                app:icon="@drawable/ic_ambulance"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Turnos Activos del Personal Hospitalario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded_16"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Médicos de turno ahora"
                android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/tvGuardiaResumen"
                android:text="Según los turnos registrados para hoy."
                android:textAppearance="@style/TextAppearance.Huc.BodySm" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPersonalGuardia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_personal_guardia" />
        </LinearLayout>

        <!-- Bitácora: GET /ambulancia/servicios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded_16"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bitácora de servicios"
                android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

            <TextView
                android:id="@+id/tvBitacoraResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cargando…"
                android:textAppearance="@style/TextAppearance.Huc.BodySm" />

            <LinearLayout
                android:id="@+id/llBitacora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
