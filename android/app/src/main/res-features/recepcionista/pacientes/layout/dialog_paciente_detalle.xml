<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/huc_surface_lowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. Encabezado de la Ficha Ampliada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_primary_container">

                <TextView
                    android:id="@+id/tvDetPacIniciales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/TextAppearance.Huc.TitleMd"
                    android:textColor="@color/huc_primary_fixed"
                    tools:text="AL" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetPacNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Huc.TitleLg"
                    tools:text="Ana López Martínez" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetPacExpediente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_primary_fixed"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_primary_fixed"
                        tools:text="EXP-2026-000012" />

                    <TextView
                        android:id="@+id/tvDetPacEstadoApp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_secondary_fixed"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_secondary_fixed"
                        tools:text="Sin vincular App" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDetPacCerrar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_surface_container_16"
                android:contentDescription="Cerrar vista ampliada"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="@color/huc_on_surface_variant" />
        </LinearLayout>

        <!-- 2. Sección de Información Básica del Paciente -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="INFORMACIÓN BÁSICA DEL PACIENTE"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_surface_low_16"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Fila 1: DUI y Sexo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documento (DUI)"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvDetPacDui"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Huc.BodyMd"
                        android:textStyle="bold"
                        tools:text="01234567-8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sexo"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvDetPacSexo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Huc.BodyMd"
                        android:textStyle="bold"
                        tools:text="Femenino" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/huc_surface_container" />

            <!-- Fila 2: Fecha de Nacimiento y Edad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de nacimiento"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvDetPacFechaNacimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Huc.BodyMd"
                        android:textStyle="bold"
                        tools:text="14/05/1985" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edad actual"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvDetPacEdad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Huc.BodyMd"
                        android:textStyle="bold"
                        tools:text="41 años" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/huc_surface_container" />

            <!-- Fila 3: Teléfono -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono de contacto"
                android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                android:textColor="@color/huc_on_surface_variant" />

            <TextView
                android:id="@+id/tvDetPacTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Huc.BodyMd"
                android:textStyle="bold"
                tools:text="7777-0000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/huc_surface_container" />

            <!-- Fila 4: Dirección -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección de domicilio"
                android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                android:textColor="@color/huc_on_surface_variant" />

            <TextView
                android:id="@+id/tvDetPacDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Huc.BodyMd"
                tools:text="Col. Escalón, San Salvador" />
        </LinearLayout>

        <!-- 3. Sección de Funciones y Opciones del Paciente -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="ACCIONES DEL PACIENTE"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetPacEditar"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="44dp"
                android:text="Editar Datos"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:icon="@drawable/ic_badge"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetPacCodigoApp"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="44dp"
                android:text="Código App"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:icon="@drawable/ic_lock"
                app:iconGravity="textStart"
                app:iconSize="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
