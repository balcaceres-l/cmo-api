<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_rounded_16"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Fila Superior: Hora 30m + Box + Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemCitaHorario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/huc_primary_container"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="09:00 - 09:30" />

        <TextView
            android:id="@+id/tvItemCitaBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_surface_container_16"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/huc_on_surface_variant"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Box 03" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvItemCitaEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tertiary_fixed"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/huc_on_tertiary_fixed"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="EN_ESPERA" />
    </LinearLayout>

    <!-- Paciente y Expediente -->
    <TextView
        android:id="@+id/tvItemCitaPaciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Huc.TitleMd"
        tools:text="Lucía Morales Castillo" />

    <TextView
        android:id="@+id/tvItemCitaMedicoYExp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/huc_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Exp: LM-2026-002 • Dr. Alejandro Restrepo (Medicina General)" />

    <TextView
        android:id="@+id/tvItemCitaMotivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Huc.BodySm"
        tools:text="Cefalea persistente y mareos matutinos" />

    <TextView
        android:id="@+id/tvItemCitaSignosResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_low_16"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/huc_primary_container"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="✓ Triaje: PA 110/70 mmHg • FC 82 lpm • SpO2 99%"
        tools:visibility="visible" />

    <!-- Acciones para estado AGENDADA -->
    <LinearLayout
        android:id="@+id/actionsCitaAgendada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCitaRegistrarLlegada"
            style="@style/Widget.Huc.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:text="Registrar Llegada"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCitaCancelarAgendada"
            style="@style/Widget.Huc.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:text="Cancelar"
            android:textColor="@color/huc_error"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Acciones para estado EN_ESPERA -->
    <LinearLayout
        android:id="@+id/actionsCitaEnEspera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCitaTriajeSignos"
            style="@style/Widget.Huc.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:text="Triaje / Signos"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCitaPasarConsulta"
            style="@style/Widget.Huc.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.15"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:text="Pasar a Consulta"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnCitaCancelarEspera"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_surface_container_16"
            android:contentDescription="Cancelar cita"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/huc_error" />
    </LinearLayout>

    <!-- Banner estado EN_ATENCION -->
    <TextView
        android:id="@+id/bannerCitaEnAtencion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_primary_fixed_16"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="● Paciente actualmente en Box con Consulta Médica Activa"
        android:textColor="@color/huc_on_primary_fixed"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
