<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvProgramarTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Huc.TitleMd"
            tools:text="Reprogramar cita" />

        <TextView
            android:id="@+id/tvProgramarPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Huc.BodySm"
            tools:text="Ana López • Motivo: control" />

        <include
            android:id="@+id/selectorAgenda"
            layout="@layout/comp_selector_agenda" />

        <TextView
            android:id="@+id/tvProgramarError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_error_container_16"
            android:padding="10dp"
            android:textColor="@color/huc_on_error_container"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="El horario ya está ocupado." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgramarCerrar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgramarGuardar"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Guardar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
