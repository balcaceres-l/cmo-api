<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huc_surface"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tarjeta Desplegable: Agendar Cita en Cascada (Especialidad -> Médico -> 30 min) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded_16"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/headerToggleAgendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_event"
                    app:tint="@color/huc_primary_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agendar nueva cita"
                        android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paciente → médico → horario libre según su turno"
                        android:textAppearance="@style/TextAppearance.Huc.BodySm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvToggleAgendarLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_secondary_fixed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="+ Abrir"
                    android:textColor="@color/huc_on_secondary_fixed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cuerpo del formulario colapsable -->
            <LinearLayout
                android:id="@+id/containerFormAgendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paciente registrado"
                    android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                    android:textColor="@color/huc_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCitaPacienteBuscar"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Buscar por nombre, DUI o expediente *"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCitaPacienteBuscar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:singleSelection="true" />

                <TextView
                    android:id="@+id/tvCitaPacienteSeleccionado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_surface_low_16"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Ningún paciente seleccionado"
                    android:textColor="@color/huc_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="2. Especialidad"
                    android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                    android:textColor="@color/huc_on_surface_variant" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEspecialidades"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <include
                    android:id="@+id/selectorAgenda"
                    layout="@layout/comp_selector_agenda" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCitaMotivo"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Motivo de la cita *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCitaMotivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvCitaFormError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_error_container_16"
                    android:padding="10dp"
                    android:textColor="@color/huc_on_error_container"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="El médico no tiene turno a esa hora." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmarAgendarCita"
                    style="@style/Widget.Huc.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Agendar cita"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <!-- Agenda del Día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Agenda Programada &amp; Sala de Espera"
                android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

            <TextView
                android:id="@+id/tvCitasTotalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary_fixed"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/huc_on_primary_fixed"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="4 citas" />
        </LinearLayout>

        <!-- Filtros de la Agenda: Estado y Doctor -->
        <HorizontalScrollView
            android:id="@+id/scrollFiltrosEstadoCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFiltroEstadoCitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFiltroDoctor"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Filtrar por Médico Asignado"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvFiltroDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Todos los Médicos" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvCitasEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_surface_low_16"
            android:gravity="center"
            android:padding="20dp"
            android:text="No se encontraron citas con los filtros seleccionados."
            android:textAppearance="@style/TextAppearance.Huc.BodySm"
            android:textColor="@color/huc_on_surface_variant"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCitasRecepcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_cita_recepcion" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
