<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huc_surface"
    android:orientation="vertical">

    <!-- ─────────────────────────────────────────────────────────────────────────
         TabLayout Superior Material 3: Gestión de Citas | Calendario de Citas
         ───────────────────────────────────────────────────────────────────────── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutCitasRecep"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/huc_surface_lowest"
        android:elevation="2dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/huc_primary_container"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/huc_primary_container"
        app:tabTextAppearance="@style/TextAppearance.Huc.TitleSm"
        app:tabTextColor="@color/huc_on_surface_variant">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_event"
            android:text="Gestión de Citas" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_calendar_today"
            android:text="Calendario" />
    </com.google.android.material.tabs.TabLayout>

    <!-- ─────────────────────────────────────────────────────────────────────────
         TAB 1: Gestión de Citas (Agendar Nueva Cita + Agenda y Sala de Espera)
         ───────────────────────────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTabGestionCitas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="80dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta Desplegable: Agendar Cita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/headerToggleAgendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_event"
                        app:tint="@color/huc_primary_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Agendar nueva cita"
                            android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Queda agendada de inmediato con médico y horario"
                            android:textAppearance="@style/TextAppearance.Huc.BodySm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvToggleAgendarLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_secondary_fixed"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="+ Abrir"
                        android:textColor="@color/huc_on_secondary_fixed"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Cuerpo del formulario colapsable -->
                <LinearLayout
                    android:id="@+id/containerFormAgendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Paciente registrado"
                        android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                        android:textColor="@color/huc_on_surface_variant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitaPacienteBuscar"
                        style="@style/Widget.Huc.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="Buscar por nombre, DUI o expediente *"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitaPacienteBuscar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPacientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:singleSelection="true" />

                    <TextView
                        android:id="@+id/tvCitaPacienteSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_surface_low_16"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="Ningún paciente seleccionado"
                        android:textColor="@color/huc_on_surface_variant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="2. Filtrar por especialidad (opcional)"
                        android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                        android:textColor="@color/huc_on_surface_variant" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupEspecialidades"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                    <include
                        android:id="@+id/selectorAgenda"
                        layout="@layout/comp_selector_agenda" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitaMotivo"
                        style="@style/Widget.Huc.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Motivo de la cita *">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitaMotivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvCitaFormError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_error_container_16"
                        android:padding="10dp"
                        android:textColor="@color/huc_on_error_container"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="El médico no tiene turno a esa hora." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmarAgendarCita"
                        style="@style/Widget.Huc.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Agendar cita"
                        app:icon="@drawable/ic_check_circle"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>

            <!-- Agenda del Día -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Agenda Programada &amp; Sala de Espera"
                    android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                <TextView
                    android:id="@+id/tvCitasTotalBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_primary_fixed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/huc_on_primary_fixed"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="4 citas" />
            </LinearLayout>

            <!-- Filtros de la Agenda: Estado, Doctor y Fecha -->
            <HorizontalScrollView
                android:id="@+id/scrollFiltrosEstadoCitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFiltroEstadoCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFiltroDoctor"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Filtrar por Médico Asignado"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvFiltroDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Todos los Médicos" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filtro por Fecha de la Cita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFiltroFechaCita"
                    style="@style/Widget.Huc.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Filtrar por fecha (DD/MM/AAAA)"
                    app:startIconDrawable="@drawable/ic_calendar_today">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFiltroFechaCita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLimpiarFiltroFechaCita"
                    style="@style/Widget.Huc.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="44dp"
                    android:text="Todas"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCitasEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_surface_low_16"
                android:gravity="center"
                android:padding="20dp"
                android:text="No se encontraron citas con los filtros seleccionados."
                android:textAppearance="@style/TextAppearance.Huc.BodySm"
                android:textColor="@color/huc_on_surface_variant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCitasRecepcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_cita_recepcion" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ─────────────────────────────────────────────────────────────────────────
         TAB 2: Módulo de Calendario de Citas Agendadas (Filtros Doctor + Fecha)
         ───────────────────────────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTabCalendarioCitas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="80dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Encabezado del Módulo de Calendario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calendario de Citas Agendadas"
                        android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulte información de la cita, día, hora y médico asignado"
                        android:textAppearance="@style/TextAppearance.Huc.BodySm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalendarioTotalBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_primary_fixed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/huc_on_primary_fixed"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="3 citas" />
            </LinearLayout>

            <!-- Tarjeta de Filtros del Calendario: Doctor y Fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtros del Calendario"
                    android:textAppearance="@style/TextAppearance.Huc.LabelMd"
                    android:textColor="@color/huc_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCalendarioDoctor"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Filtrar por Doctor"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvCalendarioDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="Todos los Médicos" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCalendarioFecha"
                        style="@style/Widget.Huc.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Filtrar por fecha (DD/MM/AAAA)"
                        app:startIconDrawable="@drawable/ic_calendar_today">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCalendarioFecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalendarioHoy"
                        style="@style/Widget.Huc.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="42dp"
                        android:text="Hoy"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalendarioTodasFechas"
                        style="@style/Widget.Huc.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="42dp"
                        android:text="Todas"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Vista de Calendario Mensual Interactivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="8dp">

                <CalendarView
                    android:id="@+id/calendarViewCitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Subtítulo dinámico y listado de citas agendadas en el calendario -->
            <TextView
                android:id="@+id/tvCalendarioSubtituloLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Citas agendadas para la fecha seleccionada"
                android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

            <TextView
                android:id="@+id/tvCalendarioEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface_low_16"
                android:gravity="center"
                android:padding="20dp"
                android:text="No hay citas agendadas para la fecha y doctor seleccionados."
                android:textAppearance="@style/TextAppearance.Huc.BodySm"
                android:textColor="@color/huc_on_surface_variant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalendarioCitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_cita_calendario" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
