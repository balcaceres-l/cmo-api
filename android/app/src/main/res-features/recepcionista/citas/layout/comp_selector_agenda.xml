<?xml version="1.0" encoding="utf-8"?>
<!-- Médico, fecha y bloque libre: lo comparten el formulario de
     agendar y el diálogo de reprogramar. Los bloques vienen de
     GET /agenda/disponibilidad, así que respetan el turno del médico. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAgendaMedico"
        style="@style/Widget.Huc.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Especialidad *"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvAgendaMedico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:textAppearance="@style/TextAppearance.Huc.BodyMd" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvMedicoSeleccionadoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_secondary_fixed"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/huc_on_secondary_fixed"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="✓ Médico asignado: Dr. Alejandro Restrepo • Medicina Interna"
        tools:visibility="visible" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAgendaFecha"
        style="@style/Widget.Huc.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Fecha de la cita *">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAgendaFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Horario libre *"
        android:textAppearance="@style/TextAppearance.Huc.LabelMd"
        android:textColor="@color/huc_on_surface_variant" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupBloques"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvAgendaAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_low_16"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/huc_on_surface_variant"
        android:textSize="12sp"
        tools:text="Seleccione especialidad y fecha para ver los horarios." />
</LinearLayout>
