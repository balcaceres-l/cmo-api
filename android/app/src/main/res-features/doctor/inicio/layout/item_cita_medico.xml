<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded_16"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="@dimen/huc_space_md">

    <!-- Cabecera: Bloque horario + Box + Estado Clínico -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCitaDocHorario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_primary"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="08:30 - 09:00"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_fixed" />

        <TextView
            android:id="@+id/tvCitaDocFechaBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="2026-10-29 • Box 03"
            android:textAppearance="@style/TextAppearance.Huc.BodySm" />

        <TextView
            android:id="@+id/tvCitaDocEstadoPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_secondary_fixed"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="EN SALA"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_on_secondary_fixed" />
    </LinearLayout>

    <!-- Nombre del Paciente + Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCitaDocPacienteNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lucía Morales Castillo"
            android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

        <TextView
            android:id="@+id/tvCitaDocLeyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tertiary_fixed"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Ley 19.628"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_on_tertiary_fixed"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCitaDocExpedienteMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="EXP: LM-2026-002 • DNI: 16.782.341-8"
        android:textAppearance="@style/TextAppearance.Huc.BodySm" />

    <!-- Motivo clínico -->
    <TextView
        android:id="@+id/tvCitaDocMotivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_low_16"
        android:padding="10dp"
        android:text="Motivo: Cefalea persistente y mareos matutinos"
        android:textAppearance="@style/TextAppearance.Huc.BodyMd" />

    <!-- Resumen de Triaje (si existe) -->
    <TextView
        android:id="@+id/tvCitaDocTriajeResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Triaje: PA 110/70 mmHg • FC 82 lpm • SpO2 99%"
        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
        android:textColor="@color/huc_primary_container" />

    <!-- Botones de Acción Médica -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCitaDocVerExpediente"
            style="@style/Widget.Huc.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ver Expediente"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:icon="@drawable/ic_folder_shared"
            app:iconSize="16dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCitaDocAccionPrincipal"
            style="@style/Widget.Huc.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:text="Iniciar Consulta"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconSize="16dp" />
    </LinearLayout>

</LinearLayout>
