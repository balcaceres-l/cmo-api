<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huc_surface"
    android:clipToPadding="false"
    android:paddingBottom="104dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/huc_space_md">

        <!-- Micro-Banner Acceso Clínico Auditado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_primary_container_16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/huc_space_md">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/huc_primary_fixed" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/huc_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acceso Clínico Auditado • Ley 19.628"
                    android:textAppearance="@style/TextAppearance.Huc.TitleSm"
                    android:textColor="@color/huc_primary_fixed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trazabilidad de lectura de historia clínica electrónica HUC"
                    android:textAppearance="@style/TextAppearance.Huc.BodySm"
                    android:textColor="@color/huc_on_primary_container" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Auditado"
                android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                android:textColor="@color/huc_primary_fixed" />
        </LinearLayout>

        <!-- Buscador de Expedientes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:background="@drawable/bg_card_rounded_16"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="@dimen/huc_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder_shared"
                    app:tint="@color/huc_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.06"
                    android:text="REPOSITORIO DE EXPEDIENTES CLÍNICOS"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                    android:textColor="@color/huc_secondary" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Huc.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_sm"
                android:hint="Buscar por Nombre, DNI o N° Expediente (ej. CM-2026-001)"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/huc_primary_container">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscarExpediente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Huc.BodyMd" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_sm"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPacientesExpediente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Mensaje sin coincidencias -->
        <TextView
            android:id="@+id/tvExpEmptySearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:background="@drawable/bg_surface_low_16"
            android:gravity="center"
            android:padding="@dimen/huc_space_lg"
            android:text="No se encontraron expedientes con ese criterio de búsqueda."
            android:textAppearance="@style/TextAppearance.Huc.BodySm"
            android:visibility="gone" />

        <!-- Contenedor Detalle del Expediente Seleccionado -->
        <LinearLayout
            android:id="@+id/containerDetalleExpediente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ficha Filiación + Ubicación + Alergia Crítica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_md"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="@dimen/huc_space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExpNumeroBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_primary_fixed"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="EXP: CM-2026-001"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_primary_fixed" />

                    <TextView
                        android:id="@+id/tvExpVipBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_tertiary_fixed"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Protegido Ley 19.628"
                        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                        android:textColor="@color/huc_on_tertiary_fixed"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExpPacienteNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Carlos Mendoza"
                    android:textAppearance="@style/TextAppearance.Huc.HeadlineSm" />

                <TextView
                    android:id="@+id/tvExpPacienteMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="45 años • DNI: 14.891.203-K • Sangre: O+"
                    android:textAppearance="@style/TextAppearance.Huc.BodySm" />

                <TextView
                    android:id="@+id/tvExpCamaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_secondary_fixed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Ubicación: Box 03"
                    android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                    android:textColor="@color/huc_on_secondary_fixed" />

                <!-- Banner Alerta Farmacológica Crítica -->
                <LinearLayout
                    android:id="@+id/bannerAlertaAlergias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huc_space_sm"
                    android:background="@drawable/bg_error_container_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/huc_on_error_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALERTA FARMACOLÓGICA CRÍTICA"
                            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                            android:textColor="@color/huc_on_error_container" />

                        <TextView
                            android:id="@+id/tvExpAlergiasDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alergia registrada"
                            android:textAppearance="@style/TextAppearance.Huc.TitleSm"
                            android:textColor="@color/huc_on_error_container" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Comorbilidades -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huc_space_sm"
                    android:text="ANTECEDENTES &amp; COMORBILIDADES"
                    android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                    android:textColor="@color/huc_outline" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupComorbilidades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Signos Vitales Registrados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_md"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="@dimen/huc_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Últimos Signos Vitales Registrados"
                    android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huc_space_sm"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/vitalExpPa"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/vitalExpPulso"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/vitalExpTemp"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/vitalExpSpo2"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/vitalExpPeso"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/vitalExpTalla"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/vitalExpImc"
                        layout="@layout/comp_vitals_chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1.3" />
                </LinearLayout>
            </LinearLayout>

            <!-- Exámenes de Laboratorio en Expediente -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_md"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="@dimen/huc_space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Exámenes de Laboratorio en Expediente"
                        android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExpIndicarExamen"
                        style="@style/Widget.Huc.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:text="+ Indicar Examen"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExpSinOrdenesLab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huc_space_sm"
                    android:text="Sin órdenes de laboratorio registradas para este expediente."
                    android:textAppearance="@style/TextAppearance.Huc.BodySm"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerOrdenesExpediente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huc_space_sm"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Historial de Atenciones Previas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_md"
                android:background="@drawable/bg_card_rounded_16"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="@dimen/huc_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Historial de Atenciones Clínicas"
                    android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAtencionesHistoricas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huc_space_sm"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
