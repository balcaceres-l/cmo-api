<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface_low_16"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistEspecialidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Medicina Interna"
            android:textAppearance="@style/TextAppearance.Huc.TitleSm"
            android:textColor="@color/huc_primary_container" />

        <TextView
            android:id="@+id/tvHistFechaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_secondary_fixed"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Hoy • 09:00"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_on_secondary_fixed" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistDiagnostico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Diagnóstico clínico"
        android:textAppearance="@style/TextAppearance.Huc.BodyMd" />

    <TextView
        android:id="@+id/tvHistNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Notas clínicas de evolución"
        android:textAppearance="@style/TextAppearance.Huc.BodySm" />

    <TextView
        android:id="@+id/tvHistMedico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Firmado por: Dr. Alejandro Restrepo"
        android:textAppearance="@style/TextAppearance.Huc.LabelSm"
        android:textColor="@color/huc_outline" />

</LinearLayout>
