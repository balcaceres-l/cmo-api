<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_low_16"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecetaMedicamento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enalapril 10mg"
                android:textAppearance="@style/TextAppearance.Huc.TitleSm" />

            <TextView
                android:id="@+id/tvRecetaTipoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary_fixed"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Crónico"
                android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                android:textColor="@color/huc_on_primary_fixed" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecetaPosologia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1 comprimido • Cada 12 hrs • 30 días"
            android:textAppearance="@style/TextAppearance.Huc.BodySm"
            android:textColor="@color/huc_on_surface" />

        <TextView
            android:id="@+id/tvRecetaIndicaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tomar en ayunas y noche."
            android:textAppearance="@style/TextAppearance.Huc.BodySm" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEliminarReceta"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar medicamento"
        android:src="@drawable/ic_delete"
        app:tint="@color/huc_error" />

</LinearLayout>
