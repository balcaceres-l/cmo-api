<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded_16"
    android:orientation="vertical"
    android:padding="@dimen/huc_space_md">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catálogo CIE-10 • Hipótesis Diagnóstica"
        android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Seleccione un código estandarizado OMS o filtre por descripción."
        android:textAppearance="@style/TextAppearance.Huc.BodySm" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Huc.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/huc_space_sm"
        android:hint="Filtrar código o patología (ej. I10, Diabetes)"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFiltroCie10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="@dimen/huc_space_sm">

        <LinearLayout
            android:id="@+id/containerListaCie10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarCie10"
        style="@style/Widget.Huc.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/huc_space_sm"
        android:text="Cerrar"
        android:textAllCaps="false" />

</LinearLayout>
