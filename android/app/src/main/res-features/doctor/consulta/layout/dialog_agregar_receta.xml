<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/huc_space_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prescribir Fármaco • Recetario Digital HUC"
            android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_sm"
            android:hint="Fármaco y concentración * (ej. Losartán 50mg)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecetaMedicamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Huc.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Dosis * (ej. 1 comp.)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecetaDosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Huc.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Duración (ej. 30 días)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecetaDuracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Frecuencia / Vía * (ej. Cada 12 hrs vía oral)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecetaFrecuencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_sm"
            android:text="RÉGIMEN TERAPÉUTICO"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_container" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTipoReceta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Indicaciones para farmacia / paciente">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecetaIndicaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecetaCancelar"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancelar"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecetaAgregar"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minHeight="44dp"
                android:text="Añadir a Receta"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
