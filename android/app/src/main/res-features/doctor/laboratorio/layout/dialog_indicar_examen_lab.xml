<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/huc_space_md">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_primary_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_science"
                    app:tint="@color/huc_primary_fixed" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/huc_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emitir Orden de Laboratorio (LIS)"
                    android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                <TextView
                    android:id="@+id/tvLabDialogSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sincronización automática con Expediente y LIS"
                    android:textAppearance="@style/TextAppearance.Huc.BodySm" />
            </LinearLayout>
        </LinearLayout>

        <!-- Selector opcional de Paciente (cuando se abre desde LIS general) -->
        <LinearLayout
            android:id="@+id/sectionSelectorPacienteLab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PACIENTE DESTINATARIO"
                android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                android:textColor="@color/huc_primary_container" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupLabPacientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Prioridad Clínica -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:text="PRIORIDAD CLÍNICA"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_container" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrioridadRutina"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Rutinario"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrioridadStat"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⚡ STAT (&lt; 30m)"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Estado Inicial LIS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:text="ESTADO INICIAL EN LIS"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_container" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEstadoInicialLab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- Catálogo de Exámenes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:text="CATÁLOGO DE PRUEBAS DISPONIBLES"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_container" />

        <LinearLayout
            android:id="@+id/containerCheckboxesExamenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_surface_low_16"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <!-- Examen personalizado -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_sm"
            android:hint="Otro examen específico (opcional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLabOtroExamen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Huc.BodyMd" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Observaciones clínicas -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_sm"
            android:hint="Justificación / Indicaciones de muestra">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLabObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:textAppearance="@style/TextAppearance.Huc.BodyMd" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLabCancelar"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancelar"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLabConfirmar"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/huc_space_sm"
                android:minHeight="44dp"
                android:text="Emitir Orden LIS"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
