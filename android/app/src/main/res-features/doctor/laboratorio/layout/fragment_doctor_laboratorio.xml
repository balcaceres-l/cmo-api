<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huc_surface"
    android:clipToPadding="false"
    android:paddingBottom="104dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/huc_space_md">

        <!-- Micro-Banner Institucional HUC -->
        <include
            android:id="@+id/microBannerLab"
            layout="@layout/comp_huc_micro_banner" />

        <!-- Tarjeta Cabecera LIS + Acción Indicar Examen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:background="@drawable/bg_card_rounded_16"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="@dimen/huc_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_science"
                    app:tint="@color/huc_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.06"
                    android:text="SISTEMA LIS • TRAZABILIDAD DE MUESTRAS"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Huc.LabelSm"
                    android:textColor="@color/huc_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laboratorio Clínico Central (LIS)"
                        android:textAppearance="@style/TextAppearance.Huc.HeadlineSm" />

                    <TextView
                        android:id="@+id/tvLabResumenContador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Órdenes sincronizadas con Consulta y Expedientes."
                        android:textAppearance="@style/TextAppearance.Huc.BodySm" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIndicarExamenLis"
                    style="@style/Widget.Huc.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="@dimen/huc_space_sm"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="42dp"
                    android:paddingHorizontal="14dp"
                    android:text="Indicar Examen"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="16dp"
                    app:iconTint="@color/huc_on_primary" />
            </LinearLayout>

            <!-- Filtros por Estado LIS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/huc_space_sm"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFiltroLis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Estado vacío -->
        <TextView
            android:id="@+id/tvLabEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:background="@drawable/bg_surface_low_16"
            android:gravity="center"
            android:padding="@dimen/huc_space_lg"
            android:text="No hay órdenes de laboratorio para el estado seleccionado."
            android:textAppearance="@style/TextAppearance.Huc.BodySm"
            android:visibility="gone" />

        <!-- Listado de Órdenes LIS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrdenesLaboratorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
