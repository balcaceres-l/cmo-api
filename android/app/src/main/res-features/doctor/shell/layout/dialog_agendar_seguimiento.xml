<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/huc_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_primary_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_event"
                    app:tint="@color/huc_primary_fixed" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agendar Cita de Seguimiento"
                    android:textAppearance="@style/TextAppearance.Huc.TitleMd" />

                <TextView
                    android:id="@+id/tvSegMedicoInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bloques reglamentarios de 30 min • Anti-solapamiento"
                    android:textAppearance="@style/TextAppearance.Huc.BodySm" />
            </LinearLayout>
        </LinearLayout>

        <!-- Selector de Paciente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:text="PACIENTE"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_container" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSegPacientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Fecha -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_sm"
            android:hint="Fecha de Control * (YYYY-MM-DD)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSegFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bloques 30 minutos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:text="BLOQUE HORARIO (30 MINUTOS)"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_primary_container" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSegBloques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- Motivo Clínico -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Huc.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_sm"
            android:hint="Motivo clínico del seguimiento *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSegMotivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvSegErrorInline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_error_container_16"
            android:padding="10dp"
            android:textAppearance="@style/TextAppearance.Huc.LabelSm"
            android:textColor="@color/huc_on_error_container"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/huc_space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSegCancelar"
                style="@style/Widget.Huc.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancelar"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSegConfirmar"
                style="@style/Widget.Huc.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minHeight="44dp"
                android:text="Confirmar Cita"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
