<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════════════════
         Escala Tipográfica Oficial CMO (Plus Jakarta Sans + JetBrains Mono)
         Estandarizada 1:1 con web/src/index.css
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- 1. Título: ExtraBold 24sp (Títulos de pantalla, panel, cifras KPI) -->
    <style name="TextAppearance.Cmo.Titulo" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:lineHeight">32sp</item>
        <item name="android:textColor">@color/cmo_text</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- 2. Subtítulo: Bold 16sp (Títulos de sección, tarjeta, nombre de paciente) -->
    <style name="TextAppearance.Cmo.Subtitulo" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/cmo_text</item>
    </style>

    <!-- 3. Cuerpo: Regular 14sp (Texto general, celdas, campos, mensaje de alerta) -->
    <style name="TextAppearance.Cmo.Cuerpo" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/cmo_text</item>
    </style>

    <!-- 4. Cuerpo/Negrita: Bold 14sp (Botones, enlaces de acción, título de alerta) -->
    <style name="TextAppearance.Cmo.CuerpoNegrita" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/cmo_text</item>
    </style>

    <!-- 5. Etiqueta: SemiBold 12sp (Chips de estado, etiquetas de campo, metadatos) -->
    <style name="TextAppearance.Cmo.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:textColor">@color/cmo_text_muted</item>
    </style>

    <!-- 6. Monoespaciado: JetBrains Mono (Cronómetro 30m, DUI, EXP, Códigos) -->
    <style name="TextAppearance.Cmo.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cmo_text</item>
    </style>

    <!-- Aliases de compatibilidad mapeados a la escala Plus Jakarta Sans -->
    <style name="TextAppearance.Huc.HeadlineMd" parent="TextAppearance.Cmo.Titulo" />
    <style name="TextAppearance.Huc.HeadlineSm" parent="TextAppearance.Cmo.Subtitulo">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">26sp</item>
    </style>
    <style name="TextAppearance.Huc.TitleLg" parent="TextAppearance.Cmo.Subtitulo">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    <style name="TextAppearance.Huc.TitleMd" parent="TextAppearance.Cmo.Subtitulo" />
    <style name="TextAppearance.Huc.TitleSm" parent="TextAppearance.Cmo.CuerpoNegrita" />
    <style name="TextAppearance.Huc.BodyMd" parent="TextAppearance.Cmo.Cuerpo" />
    <style name="TextAppearance.Huc.BodySm" parent="TextAppearance.Cmo.Etiqueta">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="TextAppearance.Huc.LabelLg" parent="TextAppearance.Cmo.CuerpoNegrita" />
    <style name="TextAppearance.Huc.LabelMd" parent="TextAppearance.Cmo.Etiqueta" />
    <style name="TextAppearance.Huc.LabelSm" parent="TextAppearance.Cmo.Etiqueta">
        <item name="android:textSize">11sp</item>
        <item name="android:lineHeight">14sp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Widgets Reutilizables Hospital CMO
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="Widget.Huc.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/cmo_surface</item>
        <item name="cardCornerRadius">@dimen/huc_radius_default</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/cmo_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Huc.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cmo_primary</item>
        <item name="android:textColor">@color/cmo_white</item>
        <item name="cornerRadius">@dimen/huc_radius_sm</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Cmo.CuerpoNegrita</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <style name="Widget.Huc.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/cmo_primary_soft</item>
        <item name="android:textColor">@color/cmo_primary</item>
        <item name="cornerRadius">@dimen/huc_radius_sm</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Cmo.CuerpoNegrita</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <style name="Widget.Huc.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/cmo_border_strong</item>
        <item name="android:textColor">@color/cmo_primary</item>
        <item name="cornerRadius">@dimen/huc_radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Cmo.Etiqueta</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <style name="Widget.Huc.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/cmo_surface_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/huc_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/huc_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/huc_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/huc_radius_sm</item>
        <item name="boxStrokeColor">@color/cmo_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/cmo_primary</item>
    </style>

    <style name="Widget.Cmo.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cmo_primary_soft</item>
    </style>
</resources>
