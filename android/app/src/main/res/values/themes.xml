<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CMOHospital" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/cmo_primary</item>
        <item name="colorOnPrimary">@color/cmo_white</item>
        <item name="colorPrimaryContainer">@color/cmo_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/cmo_primary_dark</item>

        <item name="colorSecondary">@color/triage_observacion</item>
        <item name="colorOnSecondary">@color/cmo_white</item>
        <item name="colorSecondaryContainer">@color/triage_observacion_bg</item>
        <item name="colorOnSecondaryContainer">@color/triage_observacion_text</item>

        <item name="colorTertiary">@color/triage_urgente</item>
        <item name="colorOnTertiary">@color/cmo_white</item>
        <item name="colorTertiaryContainer">@color/triage_urgente_bg</item>
        <item name="colorOnTertiaryContainer">@color/triage_urgente_text</item>

        <item name="colorError">@color/triage_critico</item>
        <item name="colorOnError">@color/cmo_white</item>
        <item name="colorErrorContainer">@color/triage_critico_bg</item>
        <item name="colorOnErrorContainer">@color/triage_critico_text</item>

        <item name="android:colorBackground">@color/cmo_bg</item>
        <item name="colorSurface">@color/cmo_surface</item>
        <item name="colorOnSurface">@color/cmo_text</item>
        <item name="colorSurfaceVariant">@color/cmo_surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/cmo_text_muted</item>
        <item name="colorOutline">@color/cmo_border_strong</item>

        <item name="android:statusBarColor">@color/cmo_header_bg</item>
        <item name="android:navigationBarColor">@color/cmo_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
