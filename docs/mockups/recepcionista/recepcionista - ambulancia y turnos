<script>
  function showToast(msg, icon = 'check_circle') {
    const toast = document.getElementById('toast-feedback');
    const toastMsg = document.getElementById('toast-message');
    const toastIcon = document.getElementById('toast-icon');
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toastIcon.textContent = icon;
    toast.classList.remove('opacity-0', 'pointer-events-none');
    toast.classList.add('opacity-100');
    setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0', 'pointer-events-none');
    }, 3200);
  }

  function setAmbulanceStatus(status) {
    const btnDisp = document.getElementById('btn-disp');
    const btnServ = document.getElementById('btn-serv');
    const btnManten = document.getElementById('btn-manten');

    // Reset styles
    [btnDisp, btnServ, btnManten].forEach(b => {
      b.className = 'py-2 rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-all flex items-center justify-center gap-1';
    });

    if (status === 'disponible') {
      btnDisp.className = 'py-2 rounded-full font-label-sm text-label-sm bg-primary text-on-primary font-bold shadow-sm transition-all flex items-center justify-center gap-1';
      showToast('Ambulancia Alfa-1 marcada como DISPONIBLE en base', 'check_circle');
    } else if (status === 'servicio') {
      btnServ.className = 'py-2 rounded-full font-label-sm text-label-sm bg-error text-on-error font-bold shadow-sm transition-all flex items-center justify-center gap-1';
      showToast('Ambulancia Alfa-1 en estado EN SERVICIO activo', 'warning');
    } else if (status === 'mantenimiento') {
      btnManten.className = 'py-2 rounded-full font-label-sm text-label-sm bg-tertiary-container text-on-tertiary-container font-bold shadow-sm transition-all flex items-center justify-center gap-1';
      showToast('Ambulancia en Mantenimiento técnico preventivo', 'build');
    }
  }

  function filterStaff(role) {
    const pills = document.querySelectorAll('.staff-pill');
    pills.forEach(p => {
      p.className = 'staff-pill px-3.5 py-1.5 rounded-full bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm whitespace-nowrap hover:bg-surface-container-high';
    });
    event.currentTarget.className = 'staff-pill px-3.5 py-1.5 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm font-semibold whitespace-nowrap shadow-sm';

    const cards = document.querySelectorAll('.staff-card');
    cards.forEach(card => {
      if (role === 'todos') {
        card.style.display = 'block';
      } else {
        const roles = card.getAttribute('data-roles') || '';
        if (roles.includes(role)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }

  function filterLog(category) {
    const btns = document.querySelectorAll('.log-filter-btn');
    btns.forEach(b => {
      b.className = 'log-filter-btn px-3 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm whitespace-nowrap hover:bg-surface-container-high';
    });
    event.currentTarget.className = 'log-filter-btn px-3 py-1 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm whitespace-nowrap shadow-sm';

    const entries = document.querySelectorAll('.log-entry');
    entries.forEach(e => {
      if (category === 'todos') {
        e.style.display = 'flex';
      } else {
        const cat = e.getAttribute('data-category');
        e.style.display = (cat === category) ? 'flex' : 'none';
      }
    });
  }

  function triggerHandoverProtocol() {
    showToast('Apertura de Libro de Guardia 15:00 hrs. Notificando a 6 profesionales.', 'draw');
  }

  function openEmergencyModal() {
    const sheet = document.getElementById('dispatch-sheet');
    sheet.classList.remove('hidden');
    sheet.classList.add('flex');
  }

  function closeEmergencyModal() {
    const sheet = document.getElementById('dispatch-sheet');
    sheet.classList.add('hidden');
    sheet.classList.remove('flex');
  }

  function submitDispatch(e) {
    e.preventDefault();
    closeEmergencyModal();
    showToast('¡Despacho de emergencia transmitido a radio cabina!', 'crisis_alert');
    setAmbulanceStatus('servicio');
  }

  // Actualizador de reloj continuo
  function updateTime() {
    const clockEl = document.getElementById('clock-display');
    if (!clockEl) return;
    const now = new Date();
    clockEl.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }
  setInterval(updateTime, 30000);
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,45,36,0.06)]" data-active-classes="text-primary-container font-semibold"><div class="flex justify-around items-center h-16 px-space-xs"><a class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-primary transition-colors" data-path="pacientes" href="#"><span class="material-symbols-outlined text-[24px]">personal_injury</span><span class="font-label-sm text-label-sm mt-0.5">Pacientes</span></a><a class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-primary transition-colors" data-path="camas-salas" href="#"><span class="material-symbols-outlined text-[24px]">hotel</span><span class="font-label-sm text-label-sm mt-0.5">Camas/Salas</span></a><a class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-primary transition-colors" data-path="interconsultas" href="#"><span class="material-symbols-outlined text-[24px]">assignment</span><span class="font-label-sm text-label-sm mt-0.5">Interconsultas</span></a><a aria-current="page" class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] transition-colors text-primary-container font-semibold" data-path="guardia" href="#"><span class="material-symbols-outlined text-[24px]">medical_services</span><span class="font-label-sm text-label-sm mt-0.5">Guardia</span></a></div></nav></body></html>
