<script>
  (function() {
    // Interacción Toggle VIP / Anonimización
    const vipToggle = document.getElementById('vip-toggle');
    const vipWrapper = document.getElementById('vip-wrapper');
    const vipDesc = document.getElementById('vip-desc');
    const vipIcon = document.getElementById('vip-icon');
    const vipIconBox = document.getElementById('vip-icon-box');

    vipToggle.addEventListener('change', function() {
      if (this.checked) {
        vipWrapper.classList.replace('bg-surface-container-low', 'bg-tertiary-fixed');
        vipDesc.textContent = 'Paciente Protegido/VIP: Nombre anonimizado en monitores públicos';
        vipDesc.classList.add('text-on-tertiary-fixed-variant', 'font-semibold');
        vipIcon.textContent = 'visibility_off';
        vipIconBox.classList.replace('bg-surface-container-highest', 'bg-tertiary-container');
        vipIconBox.classList.replace('text-on-surface-variant', 'text-on-tertiary');
      } else {
        vipWrapper.classList.replace('bg-tertiary-fixed', 'bg-surface-container-low');
        vipDesc.textContent = 'Nombre visible en pantallas y monitores de sala';
        vipDesc.classList.remove('text-on-tertiary-fixed-variant', 'font-semibold');
        vipIcon.textContent = 'visibility';
        vipIconBox.classList.replace('bg-tertiary-container', 'bg-surface-container-highest');
        vipIconBox.classList.replace('text-on-tertiary', 'text-on-surface-variant');
      }
    });

    // Simulación Escáner Cédula
    const btnScan = document.getElementById('btn-scan');
    const scanFeedback = document.getElementById('scan-feedback');
    const dniInput = document.getElementById('dni-input');
    const namesInput = document.getElementById('patient-names');
    const surnamesInput = document.getElementById('patient-surnames');
    const ageInput = document.getElementById('patient-age');
    const contactInput = document.getElementById('emergency-contact');

    btnScan.addEventListener('click', function() {
      btnScan.classList.add('opacity-70');
      btnScan.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">sync</span> Escaneando...';

      setTimeout(() => {
        btnScan.classList.remove('opacity-70');
        btnScan.innerHTML = '<span class="material-symbols-outlined text-[20px]">document_scanner</span><span class="font-label-md text-label-md uppercase">Escanear</span>';
        dniInput.value = '17.489.201-3';
        namesInput.value = 'Francisca Elena';
        surnamesInput.value = 'Navarro Silva';
        ageInput.value = '34';
        contactInput.value = 'Carlos Navarro (Hermano) +56 9 7654 3210';
        scanFeedback.classList.remove('hidden');
      }, 700);
    });

    // Selector Manchester de Triage
    const triageBtns = document.querySelectorAll('.triage-btn');
    triageBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        triageBtns.forEach(b => {
          b.classList.remove('is-active', 'shadow-sm', 'bg-tertiary-fixed', 'bg-error-container', 'bg-primary-fixed');
          b.classList.add('bg-surface-container');
          const title = b.querySelector('p');
          if (title) title.className = 'font-title-sm text-title-sm text-on-surface leading-none';
        });

        this.classList.remove('bg-surface-container');
        this.classList.add('is-active', 'shadow-sm');
        const level = this.getAttribute('data-level');
        const title = this.querySelector('p');

        if (level === '1') {
          this.classList.add('bg-error-container');
          if (title) title.className = 'font-title-sm text-title-sm text-on-error-container font-bold leading-none';
        } else if (level === '2' || level === '3') {
          this.classList.add('bg-tertiary-fixed');
          if (title) title.className = 'font-title-sm text-title-sm text-on-tertiary-fixed font-bold leading-none';
        } else {
          this.classList.add('bg-primary-fixed');
          if (title) title.className = 'font-title-sm text-title-sm text-on-primary-fixed font-bold leading-none';
        }
      });
    });

    // Selector de Camas Dinámico
    let selectedBed = null;
    const bedItems = document.querySelectorAll('.bed-item');
    const selectedBedName = document.getElementById('selected-bed-name');

    bedItems.forEach(item => {
      item.addEventListener('click', function() {
        const bedId = this.getAttribute('data-bed');

        bedItems.forEach(b => {
          b.classList.remove('bg-primary-container', 'text-on-primary');
          b.classList.add(b.hasAttribute('data-bed') && b.getAttribute('data-bed').includes('VIP') ? 'bg-surface-container' : 'bg-surface-container-lowest');
          const check = b.querySelector('.bed-check');
          if (check) check.classList.add('hidden');
        });

        this.classList.remove('bg-surface-container', 'bg-surface-container-lowest');
        this.classList.add('bg-primary-container');

        // Ajustar color de texto interno según selección
        const spanText = this.querySelector('span:not(.material-symbols-outlined)');
        if (spanText) {
          spanText.classList.remove('text-primary');
          spanText.classList.add('text-primary-fixed');
        }

        const check = this.querySelector('.bed-check');
        if (check) {
          check.classList.remove('hidden');
          check.classList.add('text-primary-fixed');
        }

        selectedBed = bedId;
        selectedBedName.textContent = bedId + ' (Asignada)';
        selectedBedName.className = 'font-title-sm text-title-sm font-bold text-on-primary px-2.5 py-0.5 rounded bg-primary-container shadow-sm';
      });
    });

    // Disparador Toast de Alerta y Flujo
    const toast = document.getElementById('toast');
    const toastTitle = document.getElementById('toast-title');
    const toastMsg = document.getElementById('toast-msg');

    function triggerFeedback(title, msg) {
      toastTitle.textContent = title;
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4500);
    }

    document.getElementById('btn-submit').addEventListener('click', function() {
      if (!selectedBed) {
        triggerFeedback('Selección Requerida', 'Debe seleccionar una de las 3 camas disponibles del sistema.');
        return;
      }
      const nombre = namesInput.value ? namesInput.value : 'Paciente Registrado';
      triggerFeedback('Ingreso Confirmado', `${nombre} asignado/a exitosamente a ${selectedBed}. Ficha sincronizada.`);
    });

    document.getElementById('btn-qr').addEventListener('click', function() {
      if (!selectedBed) {
        triggerFeedback('Atención', 'Seleccione primero una cama para estampar la ubicación en el brazalete QR.');
        return;
      }
      triggerFeedback('Brazalete QR Emitido', `Imprimiendo brazalete con UUID médico y clave criptográfica para ${selectedBed}.`);
    });

  })();
