  // Micro-interacción: Emisión de Ticket y Notificación
  const btnEmitir = document.getElementById('btn-emitir');
  const toast = document.getElementById('toast-notificacion');

  btnEmitir?.addEventListener('click', () => {
    btnEmitir.classList.add('opacity-80');
    btnEmitir.innerHTML = `
      <span class="material-symbols-outlined text-[20px] animate-spin">refresh</span>
      <span>Imprimiendo y Notificando...</span>
    `;

    setTimeout(() => {
      btnEmitir.classList.remove('opacity-80');
      btnEmitir.innerHTML = `
        <span class="material-symbols-outlined text-[20px]">print</span>
        <span>Emitir Ticket y Notificar al Médico</span>
      `;
      // Mostrar toast
      toast.classList.remove('translate-y-32');
      toast.classList.add('translate-y-0');

      setTimeout(() => {
        cerrarToast();
      }, 3500);
    }, 700);
  });

  function cerrarToast() {
    toast?.classList.remove('translate-y-0');
    toast?.classList.add('translate-y-32');
  }

  // Micro-interacción: Selección de Especialidad
  const specButtons = document.querySelectorAll('.spec-btn');
