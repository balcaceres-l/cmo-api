    const alertText = document.getElementById('stat-alert-text');

    if (type === 'stat') {
      btnStat.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-full bg-error text-on-error font-label-md text-label-md shadow-sm transition-all';
      btnRutina.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-full text-on-surface-variant font-label-md text-label-md transition-all';
      alertText.classList.remove('hidden');
    } else {
      btnRutina.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-full bg-primary-container text-on-primary font-label-md text-label-md shadow-sm transition-all';
      btnStat.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-full text-on-surface-variant font-label-md text-label-md transition-all';
      alertText.classList.add('hidden');
    }
  }

  function updateCounter() {
    const checkboxes = document.querySelectorAll('.determination-check:checked');
    const counter = document.getElementById('checked-counter');
    counter.textContent = `${checkboxes.length} seleccionadas`;
  }

  function enviarOrdenLIS() {
    const btn = document.getElementById('btn-firmar');
    const successBanner = document.getElementById('envio-success');

    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span> Cifrando con clave pública y enviando...';

    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check</span> ORDEN FIRMADA Y ENVIADA';
      btn.className = 'w-full h-12 bg-primary text-on-primary font-label-lg text-label-lg rounded-full flex items-center justify-center gap-2 uppercase tracking-wide shadow-md transition-all';
      successBanner.classList.remove('hidden');
    }, 1100);
  }

  function filterResults(status) {
    const chips = document.querySelectorAll('.filter-chip');
    chips.forEach(chip => {
      if (chip.getAttribute('data-filter') === status) {
        chip.className = 'filter-chip px-3 py-1.5 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm shadow-sm shrink-0';
      } else {
        chip.className = 'filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm shrink-0';
      }
    });

    const cards = document.querySelectorAll('#results-list article');
    cards.forEach(card => {
      const cardStatus = card.getAttribute('data-card-status');
      if (status === 'all' || cardStatus === status) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }
